# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# URL de la instancia de Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Supabase Anon Public Key (Safe for browser / client-side queries protected by RLS)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Secret Key (SOLO para backend/server.ts, NUNCA en el cliente)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
